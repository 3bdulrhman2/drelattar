    "test:browser": "node tests/browser.test.mjs",
    "test:native": "node tests/native.integration.test.mjs",
    "build:native-test": "node tests/build-native.mjs",
    "test:native-browser": "node tests/native.browser.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.1",
