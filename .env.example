# ========================================================
# Dr. Mohammed Elsayed Elattar - Premium Medical Website
# Environment Configuration Template
# ========================================================

# [1] Optional Supabase Backend Integration
# Provide your Supabase project credentials for cloud-synced admin data and future bookings.
# If left empty, the application runs in local mode (localStorage preview).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# [2] Admin Dashboard Authentication
# Master passcode for local administration mode (Default: DrElattar2026!)
VITE_ADMIN_PASSWORD=DrElattar2026!

# [3] Google Places API (New) Configuration
# Enable real-time fetching of up to 5 verified reviews from Google Maps.
# If omitted, the website displays an official verified Google badge with direct links.
VITE_GOOGLE_PLACES_API_KEY=
VITE_GOOGLE_PLACE_ID=
