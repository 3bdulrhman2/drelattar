# ========================================================
# Dr. Mohammed Elsayed Elattar - Environment Configuration Template
# ========================================================
# انسخ هذا الملف وأعد تسميته إلى ".env" ثم أضف القيم الحقيقية.
# أضف هذه المتغيرات أيضاً في لوحة تحكم Vercel →
# Project Settings → Environment Variables
# ========================================================

# [1] Supabase Backend Integration (مطلوب)
# المصدر: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Staff passwords belong in Supabase Auth, never in frontend environment variables.

# [3] Google Places API (اختياري)
# المصدر: Google Cloud Console → APIs & Services → Credentials
VITE_GOOGLE_PLACES_API_KEY=
VITE_GOOGLE_PLACE_ID=

# [4] Firebase Cloud Messaging — Web Push Notifications (اختياري)
# المصدر: Firebase Console → Project Settings → Your Web App
# تُستخدم لتفعيل إشعارات المتصفح للزوار والإداريين
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

